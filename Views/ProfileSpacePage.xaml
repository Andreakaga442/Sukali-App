<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Sukali.Views.ProfileSpacePage"
             Title="Moi"
             BackgroundColor="White">

    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="16">

            <!-- Profil -->
            <Frame Style="{StaticResource CardFrame}">
                <HorizontalStackLayout Spacing="16">
                    <Frame CornerRadius="40" WidthRequest="80" HeightRequest="80" Padding="0" BackgroundColor="{StaticResource HighlightColor}" BorderColor="{StaticResource PrimaryColor}">
                        <Image Source="sukali_logo.png" Aspect="AspectFit" Margin="8" />
                    </Frame>
                    <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                        <Label Text="Andrea Kaga" Style="{StaticResource TitleLabel}" FontSize="20" />
                        <Label Text="Étudiante • Informatique" Style="{StaticResource SubtitleLabel}" FontSize="13" />
                        <Label Text="Douala, Cameroun" FontSize="12" TextColor="{StaticResource TextSecondaryColor}" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </Frame>

            <!-- Onglets -->
            <HorizontalStackLayout Spacing="8">
                <Frame BackgroundColor="{StaticResource HighlightColor}" CornerRadius="20" Padding="16,6">
                    <Label Text="Mes événements" FontAttributes="Bold" TextColor="{StaticResource PrimaryColor}" FontSize="13" />
                </Frame>
                <Frame BackgroundColor="{StaticResource SurfaceColor}" CornerRadius="20" Padding="16,6">
                    <Label Text="Favoris" TextColor="{StaticResource TextSecondaryColor}" FontSize="13" />
                </Frame>
                <Frame BackgroundColor="{StaticResource SurfaceColor}" CornerRadius="20" Padding="16,6">
                    <Label Text="Abonnements" TextColor="{StaticResource TextSecondaryColor}" FontSize="13" />
                </Frame>
            </HorizontalStackLayout>

            <!-- Mes événements -->
            <Label Text="Mes événements" Style="{StaticResource BodyLabel}" FontAttributes="Bold" />

            <CollectionView ItemsSource="{Binding MyEvents}">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Style="{StaticResource CardFrame}">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnEventTapped" />
                            </Frame.GestureRecognizers>
                            <HorizontalStackLayout Spacing="12">
                                <Frame WidthRequest="60" HeightRequest="60" CornerRadius="12" Padding="0" BackgroundColor="{StaticResource SurfaceColor}">
                                    <Image Source="{Binding ImageUrl}" Aspect="AspectFill" />
                                </Frame>
                                <VerticalStackLayout Spacing="4" HorizontalOptions="StartAndExpand">
                                    <Label Text="{Binding Title}" Style="{StaticResource BodyLabel}" FontAttributes="Bold" />
                                    <Label Text="{Binding Date, StringFormat='{0:dd MMM yyyy}'}" FontSize="12" TextColor="{StaticResource TextSecondaryColor}" />
                                    <Label Text="{Binding Location}" FontSize="12" TextColor="{StaticResource TextSecondaryColor}" />
                                </VerticalStackLayout>
                                <Frame BackgroundColor="{StaticResource SurfaceColor}" CornerRadius="8" Padding="6,2">
                                    <Label Text="{Binding IsDraft, Converter={StaticResource BoolToDraftLabelConverter}}" FontSize="10" TextColor="{StaticResource TextSecondaryColor}" />
                                </Frame>
                            </HorizontalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Liens rapides -->
            <Label Text="Liens rapides" Style="{StaticResource BodyLabel}" FontAttributes="Bold" />
            <Frame Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="12">
                    <HorizontalStackLayout Spacing="12">
                        <Image Source="notification_icon.png" WidthRequest="20" HeightRequest="20" />
                        <Label Text="Notifications" Style="{StaticResource BodyLabel}" VerticalOptions="Center" HorizontalOptions="StartAndExpand" />
                        <Label Text=">" FontSize="20" TextColor="{StaticResource TextSecondaryColor}" />
                        <HorizontalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNotificationsTapped" />
                        </HorizontalStackLayout.GestureRecognizers>
                    </HorizontalStackLayout>
                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}" />
                    <HorizontalStackLayout Spacing="12">
                        <Image Source="settings_icon.png" WidthRequest="20" HeightRequest="20" />
                        <Label Text="Paramètres" Style="{StaticResource BodyLabel}" VerticalOptions="Center" HorizontalOptions="StartAndExpand" />
                        <Label Text=">" FontSize="20" TextColor="{StaticResource TextSecondaryColor}" />
                        <HorizontalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSettingsTapped" />
                        </HorizontalStackLayout.GestureRecognizers>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- Préférences -->
            <Label Text="Préférences" Style="{StaticResource BodyLabel}" FontAttributes="Bold" />

            <Frame Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="12">
                    <HorizontalStackLayout Spacing="12">
                        <Image Source="notification_icon.png" WidthRequest="20" HeightRequest="20" />
                        <Label Text="Notifications" Style="{StaticResource BodyLabel}" VerticalOptions="Center" HorizontalOptions="StartAndExpand" />
                        <Switch IsToggled="True" ThumbColor="{StaticResource PrimaryColor}" />
                    </HorizontalStackLayout>
                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}" />
                    <HorizontalStackLayout Spacing="12">
                        <Image Source="darkmode_icon.png" WidthRequest="20" HeightRequest="20" />
                        <Label Text="Mode sombre" Style="{StaticResource BodyLabel}" VerticalOptions="Center" HorizontalOptions="StartAndExpand" />
                        <Switch IsToggled="False" ThumbColor="{StaticResource PrimaryColor}" />
                    </HorizontalStackLayout>
                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}" />
                    <HorizontalStackLayout Spacing="12">
                        <Image Source="location_icon.png" WidthRequest="20" HeightRequest="20" />
                        <Label Text="Localisation" Style="{StaticResource BodyLabel}" VerticalOptions="Center" HorizontalOptions="StartAndExpand" />
                        <Switch IsToggled="True" ThumbColor="{StaticResource PrimaryColor}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- Déconnexion -->
            <Button Text="Se déconnecter"
                    Style="{StaticResource OutlineButton}"
                    Margin="0,16,0,0"
                    Clicked="OnLogoutClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
