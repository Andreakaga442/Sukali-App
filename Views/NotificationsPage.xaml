<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Sukali.Views.NotificationsPage"
             Title="Notifications"
             BackgroundColor="White">

    <ScrollView>
        <VerticalStackLayout Spacing="12" Padding="16">

            <Label Text="Notifications" Style="{StaticResource TitleLabel}" FontSize="22" Margin="0,0,0,8" />

            <!-- Notification 1 -->
            <Frame Style="{StaticResource CardFrame}">
                <HorizontalStackLayout Spacing="12">
                    <Frame CornerRadius="20" WidthRequest="40" HeightRequest="40" Padding="0" BackgroundColor="{StaticResource HighlightColor}">
                        <Image Source="sukali_logo.png" Aspect="AspectFit" Margin="6" />
                    </Frame>
                    <VerticalStackLayout Spacing="4" HorizontalOptions="StartAndExpand">
                        <Label Text="Nouvel événement" Style="{StaticResource BodyLabel}" FontAttributes="Bold" />
                        <Label Text="Festival de Musique de Douala - Dans 3 jours" Style="{StaticResource BodyLabel}" FontSize="13" />
                        <Label Text="Il y a 2 heures" FontSize="11" TextColor="{StaticResource TextSecondaryColor}" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </Frame>

            <!-- Notification 2 -->
            <Frame Style="{StaticResource CardFrame}">
                <HorizontalStackLayout Spacing="12">
                    <Frame CornerRadius="20" WidthRequest="40" HeightRequest="40" Padding="0" BackgroundColor="{StaticResource HighlightColor}">
                        <Image Source="sukali_logo.png" Aspect="AspectFit" Margin="6" />
                    </Frame>
                    <VerticalStackLayout Spacing="4" HorizontalOptions="StartAndExpand">
                        <Label Text="J'aime" Style="{StaticResource BodyLabel}" FontAttributes="Bold" />
                        <Label Text="Marie Kaga a aimé votre commentaire" Style="{StaticResource BodyLabel}" FontSize="13" />
                        <Label Text="Il y a 5 heures" FontSize="11" TextColor="{StaticResource TextSecondaryColor}" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </Frame>

            <!-- Notification 3 -->
            <Frame Style="{StaticResource CardFrame}">
                <HorizontalStackLayout Spacing="12">
                    <Frame CornerRadius="20" WidthRequest="40" HeightRequest="40" Padding="0" BackgroundColor="{StaticResource HighlightColor}">
                        <Image Source="sukali_logo.png" Aspect="AspectFit" Margin="6" />
                    </Frame>
                    <VerticalStackLayout Spacing="4" HorizontalOptions="StartAndExpand">
                        <Label Text="Réservation confirmée" Style="{StaticResource BodyLabel}" FontAttributes="Bold" />
                        <Label Text="Votre place pour le Festival de Musique est confirmée" Style="{StaticResource BodyLabel}" FontSize="13" />
                        <Label Text="Hier" FontSize="11" TextColor="{StaticResource TextSecondaryColor}" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </Frame>

            <!-- Notification 4 -->
            <Frame Style="{StaticResource CardFrame}">
                <HorizontalStackLayout Spacing="12">
                    <Frame CornerRadius="20" WidthRequest="40" HeightRequest="40" Padding="0" BackgroundColor="{StaticResource HighlightColor}">
                        <Image Source="sukali_logo.png" Aspect="AspectFit" Margin="6" />
                    </Frame>
                    <VerticalStackLayout Spacing="4" HorizontalOptions="StartAndExpand">
                        <Label Text="Événement près de vous" Style="{StaticResource BodyLabel}" FontAttributes="Bold" />
                        <Label Text="Match de Football Local - 2 km" Style="{StaticResource BodyLabel}" FontSize="13" />
                        <Label Text="Hier" FontSize="11" TextColor="{StaticResource TextSecondaryColor}" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
