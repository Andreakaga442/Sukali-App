<?xml version="1.0" encoding="utf-8" ?>
<Shell
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Sukali.Views"
    x:Class="Sukali.Views.MainTabsPage"
    Title="Sukali"
    Shell.NavBarIsVisible="False">

    <TabBar>
        <Tab Title="Accueil">
            <ShellContent ContentTemplate="{DataTemplate views:HomePage}" />
        </Tab>
        <Tab Title="Explorer">
            <ShellContent ContentTemplate="{DataTemplate views:ExplorePage}" />
        </Tab>
        <Tab Title="Créer">
            <ShellContent ContentTemplate="{DataTemplate views:CreatePage}" />
        </Tab>
        <Tab Title="Live">
            <ShellContent ContentTemplate="{DataTemplate views:LivePage}" />
        </Tab>
        <Tab Title="Moi">
            <ShellContent ContentTemplate="{DataTemplate views:ProfileSpacePage}" />
        </Tab>
    </TabBar>

</Shell>
