<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Sukali.Views.SettingsPage"
             Title="Paramètres"
             BackgroundColor="White">

    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="16">

            <Label Text="Paramètres" Style="{StaticResource TitleLabel}" FontSize="22" Margin="0,0,0,8" />

            <!-- Profil -->
            <Label Text="Profil" Style="{StaticResource BodyLabel}" FontAttributes="Bold" />
            <Frame Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="12">
                    <HorizontalStackLayout Spacing="12">
                        <Image Source="profile_icon.png" WidthRequest="20" HeightRequest="20" />
                        <Label Text="Modifier le profil" Style="{StaticResource BodyLabel}" VerticalOptions="Center" HorizontalOptions="StartAndExpand" />
                        <Label Text=">" FontSize="20" TextColor="{StaticResource TextSecondaryColor}" />
                    </HorizontalStackLayout>
                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}" />
                    <HorizontalStackLayout Spacing="12">
                        <Image Source="email_icon.png" WidthRequest="20" HeightRequest="20" />
                        <Label Text="E-mail" Style="{StaticResource BodyLabel}" VerticalOptions="Center" />
                        <Label Text="andrea.kaga@example.com" FontSize="12" TextColor="{StaticResource TextSecondaryColor}" HorizontalOptions="EndAndExpand" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- Notifications -->
            <Label Text="Notifications" Style="{StaticResource BodyLabel}" FontAttributes="Bold" />
            <Frame Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="12">
                    <HorizontalStackLayout Spacing="12">
                        <Image Source="notification_icon.png" WidthRequest="20" HeightRequest="20" />
                        <Label Text="Notifications push" Style="{StaticResource BodyLabel}" VerticalOptions="Center" HorizontalOptions="StartAndExpand" />
                        <Switch IsToggled="True" ThumbColor="{StaticResource PrimaryColor}" />
                    </HorizontalStackLayout>
                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}" />
                    <HorizontalStackLayout Spacing="12">
                        <Image Source="email_icon.png" WidthRequest="20" HeightRequest="20" />
                        <Label Text="Notifications e-mail" Style="{StaticResource BodyLabel}" VerticalOptions="Center" HorizontalOptions="StartAndExpand" />
                        <Switch IsToggled="False" ThumbColor="{StaticResource PrimaryColor}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- Apparence -->
            <Label Text="Apparence" Style="{StaticResource BodyLabel}" FontAttributes="Bold" />
            <Frame Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="12">
                    <HorizontalStackLayout Spacing="12">
                        <Image Source="darkmode_icon.png" WidthRequest="20" HeightRequest="20" />
                        <Label Text="Mode sombre" Style="{StaticResource BodyLabel}" VerticalOptions="Center" HorizontalOptions="StartAndExpand" />
                        <Switch IsToggled="False" ThumbColor="{StaticResource PrimaryColor}" />
                    </HorizontalStackLayout>
                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}" />
                    <HorizontalStackLayout Spacing="12">
                        <Image Source="palette_icon.png" WidthRequest="20" HeightRequest="20" />
                        <Label Text="Thème" Style="{StaticResource BodyLabel}" VerticalOptions="Center" />
                        <Label Text="Marron" FontSize="12" TextColor="{StaticResource TextSecondaryColor}" HorizontalOptions="EndAndExpand" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- Confidentialité -->
            <Label Text="Confidentialité" Style="{StaticResource BodyLabel}" FontAttributes="Bold" />
            <Frame Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="12">
                    <HorizontalStackLayout Spacing="12">
                        <Image Source="location_icon.png" WidthRequest="20" HeightRequest="20" />
                        <Label Text="Localisation" Style="{StaticResource BodyLabel}" VerticalOptions="Center" HorizontalOptions="StartAndExpand" />
                        <Switch IsToggled="True" ThumbColor="{StaticResource PrimaryColor}" />
                    </HorizontalStackLayout>
                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}" />
                    <HorizontalStackLayout Spacing="12">
                        <Image Source="privacy_icon.png" WidthRequest="20" HeightRequest="20" />
                        <Label Text="Confidentialité des données" Style="{StaticResource BodyLabel}" VerticalOptions="Center" HorizontalOptions="StartAndExpand" />
                        <Label Text=">" FontSize="20" TextColor="{StaticResource TextSecondaryColor}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- À propos -->
            <Label Text="À propos" Style="{StaticResource BodyLabel}" FontAttributes="Bold" />
            <Frame Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="12">
                    <HorizontalStackLayout Spacing="12">
                        <Image Source="info_icon.png" WidthRequest="20" HeightRequest="20" />
                        <Label Text="Version" Style="{StaticResource BodyLabel}" VerticalOptions="Center" />
                        <Label Text="1.0.0" FontSize="12" TextColor="{StaticResource TextSecondaryColor}" HorizontalOptions="EndAndExpand" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}" />
                    <HorizontalStackLayout Spacing="12">
                        <Image Source="document_icon.png" WidthRequest="20" HeightRequest="20" />
                        <Label Text="Conditions d'utilisation" Style="{StaticResource BodyLabel}" VerticalOptions="Center" HorizontalOptions="StartAndExpand" />
                        <Label Text=">" FontSize="20" TextColor="{StaticResource TextSecondaryColor}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- Déconnexion -->
            <Button Text="Se déconnecter"
                    Style="{StaticResource OutlineButton}"
                    Margin="0,16,0,0"
                    Clicked="OnLogoutClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
