<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Sukali.Views.SplashScreenPage1"
             BackgroundColor="#432818"
             Shell.NavBarIsVisible="False">

    <Grid>
        <!-- Fond avec dégradé -->
        <BoxView BackgroundColor="#432818" />

        <!-- Logo animé -->
        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="20">
            <Image x:Name="LogoImage"
                   Source="sukali_logo.png"
                   HeightRequest="150"
                   WidthRequest="150"
                   Aspect="AspectFit"
                   Opacity="0"
                   Scale="0.5">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnLogoTapped" />
                </Image.GestureRecognizers>
            </Image>

            <Label x:Name="SloganLabel"
                   Text="Votre agenda social local"
                   TextColor="#FFE6A7"
                   FontSize="18"
                   HorizontalOptions="Center"
                   Opacity="0" />
        </VerticalStackLayout>

        <!-- Indicateur de progression -->
        <ActivityIndicator x:Name="LoadingIndicator"
                           IsRunning="True"
                           Color="#FFE6A7"
                           VerticalOptions="End"
                           Margin="0,0,0,60"
                           Opacity="0" />
    </Grid>
</ContentPage>
