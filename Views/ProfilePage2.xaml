<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Sukali.Views.ProfilePage2"
             Title="Centres d'intérêt"
             BackgroundColor="White"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="24">

            <!-- Indicateur de progression -->
            <Grid ColumnDefinitions="*,*,*" Margin="0,20,0,0">
                <Frame Grid.Column="0" BackgroundColor="{StaticResource PrimaryColor}" CornerRadius="4" HeightRequest="4" Margin="0,0,4,0" />
                <Frame Grid.Column="1" BackgroundColor="{StaticResource PrimaryColor}" CornerRadius="4" HeightRequest="4" Margin="4,0" />
                <Frame Grid.Column="2" BackgroundColor="{StaticResource BorderColor}" CornerRadius="4" HeightRequest="4" Margin="4,0,0,0" />
            </Grid>

            <!-- Titre -->
            <VerticalStackLayout Spacing="8" Margin="0,20,0,0">
                <Label Text="Tes centres d'intérêt" Style="{StaticResource TitleLabel}" />
                <Label Text="Sélectionne ce qui t'intéresse" Style="{StaticResource SubtitleLabel}" />
            </VerticalStackLayout>

            <!-- Grille de catégories -->
            <FlexLayout Wrap="Wrap" JustifyContent="Start">
                <Frame Style="{StaticResource ChipFrame}" Margin="0,0,8,8">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCategoryTapped" />
                    </Frame.GestureRecognizers>
                    <Label Text="Concours" Style="{StaticResource BodyLabel}" />
                </Frame>

                <Frame Style="{StaticResource ChipFrame}" Margin="0,0,8,8">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCategoryTapped" />
                    </Frame.GestureRecognizers>
                    <Label Text="Musique" Style="{StaticResource BodyLabel}" />
                </Frame>

                <Frame Style="{StaticResource ChipFrame}" Margin="0,0,8,8">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCategoryTapped" />
                    </Frame.GestureRecognizers>
                    <Label Text="Ateliers" Style="{StaticResource BodyLabel}" />
                </Frame>

                <Frame Style="{StaticResource ChipFrame}" Margin="0,0,8,8">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCategoryTapped" />
                    </Frame.GestureRecognizers>
                    <Label Text="Conférences" Style="{StaticResource BodyLabel}" />
                </Frame>

                <Frame Style="{StaticResource ChipFrame}" Margin="0,0,8,8">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCategoryTapped" />
                    </Frame.GestureRecognizers>
                    <Label Text="Sport" Style="{StaticResource BodyLabel}" />
                </Frame>

                <Frame Style="{StaticResource ChipFrame}" Margin="0,0,8,8">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCategoryTapped" />
                    </Frame.GestureRecognizers>
                    <Label Text="Culture" Style="{StaticResource BodyLabel}" />
                </Frame>

                <Frame Style="{StaticResource ChipFrame}" Margin="0,0,8,8">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCategoryTapped" />
                    </Frame.GestureRecognizers>
                    <Label Text="Éducation" Style="{StaticResource BodyLabel}" />
                </Frame>

                <Frame Style="{StaticResource ChipFrame}" Margin="0,0,8,8">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCategoryTapped" />
                    </Frame.GestureRecognizers>
                    <Label Text="Professionnel" Style="{StaticResource BodyLabel}" />
                </Frame>
            </FlexLayout>

            <!-- Période souhaitée -->
            <VerticalStackLayout Spacing="8" Margin="0,16,0,0">
                <Label Text="Quand veux-tu être notifié ?" Style="{StaticResource BodyLabel}" FontAttributes="Bold" />
                <HorizontalStackLayout Spacing="12">
                    <Frame Style="{StaticResource ChipFrame}">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTimeTapped" />
                        </Frame.GestureRecognizers>
                        <Label Text="Matin" Style="{StaticResource BodyLabel}" />
                    </Frame>
                    <Frame Style="{StaticResource ChipFrame}">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTimeTapped" />
                        </Frame.GestureRecognizers>
                        <Label Text="Après-midi" Style="{StaticResource BodyLabel}" />
                    </Frame>
                    <Frame Style="{StaticResource ChipFrame}">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTimeTapped" />
                        </Frame.GestureRecognizers>
                        <Label Text="Soir" Style="{StaticResource BodyLabel}" />
                    </Frame>
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- Boutons -->
            <Grid ColumnDefinitions="*,*" Margin="0,24,0,0">
                <Button Grid.Column="0"
                        Text="Retour"
                        Style="{StaticResource OutlineButton}"
                        Margin="0,0,8,0"
                        Clicked="OnBackClicked" />
                <Button Grid.Column="1"
                        Text="Continuer"
                        Style="{StaticResource PrimaryButton}"
                        Margin="8,0,0,0"
                        Clicked="OnContinueClicked" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
